# RFP Copilot v2 — environment template. Copy to .env and edit.
# The full pipeline must run with these defaults alone. No cloud key is ever required.

# --- LLM provider ---
# "ollama" is the only provider required by any acceptance test.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_CHEAP=qwen2.5:7b-instruct
LLM_MODEL_STRONG=qwen2.5:7b-instruct
LLM_MODEL_FALLBACK=llama3.1:8b-instruct
LLM_TIMEOUT_SECONDS=180
LLM_MAX_JSON_RETRIES=1

# --- Local models ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional cloud accelerators. Leave blank. Never required. ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Paths (relative to repo root) ---
DATA_DIR=data
DB_DIR=db
OUTPUT_DIR=output
