# RFP Copilot v2 — environment template. Copy to .env and edit.
# NEVER commit .env. Keys are secrets.

# --------------------------------------------------------------------------------------
# Provider routing
# --------------------------------------------------------------------------------------
# Comma-separated failover chain, tried left to right. On a 429 or a provider error the
# next one is used. Pooling three free tiers is what makes a live demo run survivable.
# Valid names: groq, gemini, huggingface, ollama
LLM_PROVIDER_CHAIN=groq,gemini,huggingface

# Set to ollama to force the fully-local offline path (slow — see CLAUDE.md).
# LLM_PROVIDER_CHAIN=ollama

# --------------------------------------------------------------------------------------
# API keys — all free tier, no card required
# --------------------------------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# --------------------------------------------------------------------------------------
# Models per tier. "cheap" is the workhorse; "strong" is for assurance and long context.
# --------------------------------------------------------------------------------------
GROQ_MODEL_CHEAP=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile

GEMINI_MODEL_CHEAP=gemini-2.5-flash-lite
GEMINI_MODEL_STRONG=gemini-2.5-flash

HUGGINGFACE_MODEL_CHEAP=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_MODEL_STRONG=meta-llama/Llama-3.3-70B-Instruct

# Offline degradation path. 3b measured at 5.7 tok/s here; 7b at 0.15 tok/s.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CHEAP=qwen2.5:3b-instruct
OLLAMA_MODEL_STRONG=qwen2.5:3b-instruct

# --------------------------------------------------------------------------------------
# Rate limiting and resilience — throttle before the remote does
# --------------------------------------------------------------------------------------
GROQ_RPM=28
GEMINI_RPM=14
HUGGINGFACE_RPM=10
OLLAMA_RPM=1000

LLM_TIMEOUT_SECONDS=90
LLM_MAX_JSON_RETRIES=1
LLM_MAX_ATTEMPTS_PER_PROVIDER=2
LLM_MAX_CONCURRENCY=4

# Cache agent outputs by content hash. Speeds re-runs; the UI must still show
# which results were cached rather than passing them off as live.
LLM_CACHE_ENABLED=true

# --------------------------------------------------------------------------------------
# Local models — deliberately NOT cloud (see CLAUDE.md provider policy)
# --------------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --------------------------------------------------------------------------------------
# Paths (relative to repo root)
# --------------------------------------------------------------------------------------
DATA_DIR=data
DB_DIR=db
OUTPUT_DIR=output
